rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.email == "admin@teras.id" ||
         request.auth.token.email == "dkvsmkmuhipa@gmail.com" ||
         exists(/databases/$(database)/documents/admins/$(request.auth.token.email)));
    }

    // ===============================================================
    // Rules for Collections
    // ===============================================================

    // Houses
    match /houses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // CashFlow
    match /cashFlow/{id} {
      allow read, write: if isAdmin();
    }

    // Officials
    match /officials/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ronda
    match /ronda/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reports
    match /reports/{id} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    // Letters
    match /letters/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Incoming Mails (Surat Masuk RT)
    match /incomingMails/{id} {
      allow read, write: if isAdmin();
    }

    // Inventory
    match /inventory/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // UMKM
    match /umkm/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // UMKM Orders
    match /umkmOrders/{id} {
      allow create, read, update: if true;
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{id} {
      allow read, update, delete: if true;
      allow create: if isAdmin();
    }

    // Polls
    match /polls/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if true;
    }

    // Ronda Logs
    match /rondaLogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Patrol Sessions
    match /patrolSessions/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Market Items
    match /marketItems/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Bills
    match /bills/{id} {
      allow read, write: if isAdmin();
    }

    // News
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Checkpoints
    match /checkpoints/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Map Points
    match /mapPoints/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Documents
    match /documents/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Population Logs
    match /populationLogs/{id} {
      allow read, write: if isAdmin();
    }

    // Iuran Payments
    match /iuranPayments/{id} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // Resident Registrations
    match /residentRegistrations/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Guest Reports
    match /guestReports/{id} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    // Inventory Logs
    match /inventoryLogs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audit Logs
    match /auditLogs/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Activities
    match /activities/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Attendance & Ronda Attendance
    match /attendance/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
    match /rondaAttendance/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Population Reports
    match /populationReports/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ronda Swap Requests
    match /rondaSwapRequests/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Health Records
    match /healthRecords/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // FAQ
    match /faq/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Events
    match /events/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Waste Deposits
    match /wasteDeposits/{id} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    // Waste Prices
    match /wastePrices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Waste Balances
    match /wasteBalances/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Donation Campaigns
    match /donationCampaigns/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Donation Records
    match /donationRecords/{id} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    // Panic Alerts
    match /panicAlerts/{id} {
      allow create, read: if true;
      allow update, delete: if isAdmin();
    }

    // Update Requests
    match /updateRequests/{id} {
      allow create: if true;
      allow read: if isAdmin() || (resource != null && resource.data.houseId != null);
      allow update, delete: if isAdmin();
    }

    // Official Letters
    match /officialLetters/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FCM Tokens
    match /fcmTokens/{id} {
      allow create, update: if true;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // Configs
    match /configs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Books
    match /books/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Book Exchange Requests
    match /bookExchangeRequests/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Gallery
    match /gallery/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Resident Vehicles (Stiker Kendaraan Satpam)
    match /residentVehicles/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Asset Borrow Requests (Peminjaman Aset RT)
    match /assetBorrowRequests/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Community Works (Agenda Kerja Bakti & Gotong Royong)
    match /communityWorks/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Monthly Activity Reports (Laporan Bulanan Kegiatan RT)
    match /monthlyActivityReports/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Annual / Semester LPJ Reports (Laporan Pertanggungjawaban Tahunan RT)
    match /annualLPJReports/{id} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

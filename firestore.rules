rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "dkvsmkmuhipa@gmail.com" && request.auth.token.email_verified == true));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Rules for Collections
    // ===============================================================

    // Houses: Only Admins can see all. Residents can only see their own if they have the ID.
    // Since residents use accessCode, we can't easily check it here without a custom claim.
    // For now, we allow read if they know the document ID, but list is only for admins.
    match /houses/{houseId} {
      allow read: if isAdmin() || isAuthenticated(); // Allow read for authenticated users
      allow write: if isAdmin(); // Only admins can modify house data
    }

    // Reports: Anyone can create, only admins can see all and update.
    match /reports/{reportId} {
      allow create: if true; // Allow public reporting
      allow read, update, delete: if isAdmin();
    }

    // Letters: Anyone can create, only admins can see all and update.
    match /letters/{letterId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Audit Logs: Only admins can read, only system/admins can write.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Allow logging from authenticated users
    }

    // Resident Registrations
    match /residentRegistrations/{regId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Update Requests
    match /updateRequests/{reqId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Guest Reports
    match /guestReports/{guestId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

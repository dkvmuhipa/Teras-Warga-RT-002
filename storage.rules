rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow public read for all files
    match /{allPaths=**} {
      allow read: if true;
    }

    // Public uploads for resident registrations & guest reports
    match /registrations/{allPaths=**} {
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /guests/{allPaths=**} {
      allow write: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // General uploads
    match /{allPaths=**} {
      allow write: if request.resource.size < 15 * 1024 * 1024;
    }
  }
}
